# Telegram
BOT_TOKEN=123456:ABC-your-token-here

# Пользователи, на которых НЕ действуют ограничения (warn/mute/ban/kick и
# автомодерация). Список Telegram ID через запятую. Сам бот защищён всегда.
PROTECTED_IDS=

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kirians
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kirians_filter

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Bot behaviour defaults (can be overridden per-chat via /settings)
DEFAULT_WARN_LIMIT=3
DEFAULT_MUTE_MINUTES=60
ANTIFLOOD_MESSAGES=5
ANTIFLOOD_WINDOW_SECONDS=5
CAPTCHA_TIMEOUT_SECONDS=120

# Срок хранения текстов сообщений и журнала действий (дни).
ARCHIVE_RETENTION_DAYS=90

# Для существующей установки укажите проект, которому принадлежит pgdata.
# COMPOSE_PROJECT_NAME=kirians-filter
